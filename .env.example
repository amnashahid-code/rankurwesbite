# Separate Supabase projects and provider keys for development/test/production.
APP_ENV=development
# Optional interface samples. Never used by the real dashboard.
ENABLE_DEMO=false
NEXT_PUBLIC_APP_NAME=RankYourWebsite
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to a header that YOUR reverse proxy overwrites, never one it merely forwards.
# On Vercel, use x-vercel-forwarded-for. Without this all anonymous users share a limit.
TRUSTED_IP_HEADER=
CRON_SECRET=

# International hosted checkout. No public Stripe key needed for hosted redirect.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Pakistan PayFast. Obtain merchant integration contract from gopayfast.com.
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_CHECKOUT_BASE_URL=https://ipguat.apps.net.pk
PAYFAST_TRANSACTION_API_URL=
PAYFAST_TRANSACTION_API_TOKEN=
# Reserved for merchant-specific webhook variants. Current adapter uses validation_hash.
PAYFAST_WEBHOOK_SECRET=
# Set an approved quoted conversion rate; never derive money from client input.
PAYFAST_USD_TO_PKR=
# Enable ONLY after confirming callback/hash/status/amount/currency contract in UAT.
PAYFAST_CONTRACT_VERIFIED=false

# Optional AI explanations. Without these, useful rules-based reports still work.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional mobile Lighthouse performance measurements and real SERP tracking.
PAGESPEED_API_KEY=
SERPAPI_KEY=
